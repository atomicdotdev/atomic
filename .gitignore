# =============================================================================
# Atomic VCS - .gitignore
# =============================================================================

# =============================================================================
# Rust / Cargo
# =============================================================================

# Generated by Cargo - build artifacts
/target/
**/target/

# Cargo.lock is included for binaries, but you may want to gitignore for libraries
# Uncomment if this becomes a library-only project:
# Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds
*.pdb

# =============================================================================
# IDE and Editor Files
# =============================================================================

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains IDEs (IntelliJ, CLion, RustRover)
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# Sublime Text
*.sublime-workspace
*.sublime-project

# Zed
.zed/

# =============================================================================
# Operating System Files
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# =============================================================================
# Testing and Coverage
# =============================================================================

# Code coverage reports
*.profraw
*.profdata
coverage/
lcov.info
tarpaulin-report.html
cobertura.xml

# Test databases and temporary files
*.db
*.db-journal
*.mdb
*.lock.mdb
test_repos/
tmp/
temp/

# =============================================================================
# Documentation Build Artifacts
# =============================================================================

# Generated documentation
/doc/
**/doc/

# mdBook output
book/

# =============================================================================
# Logs and Debug Output
# =============================================================================

*.log
logs/
debug/

# =============================================================================
# Environment and Secrets
# =============================================================================

# Environment files
.env
.env.local
.env.*.local
*.env

# Secret keys and credentials
*.pem
*.key
*.crt
secrets/

# =============================================================================
# Project-Specific
# =============================================================================

# Atomic repository data (for testing)
.atomic/

# Benchmark results
criterion/
benches/target/

# Fuzzing artifacts
fuzz/target/
fuzz/corpus/
fuzz/artifacts/

# =============================================================================
# DO NOT IGNORE - Important Project Files
# =============================================================================

# These files ARE tracked and should NOT be ignored:
# - AGENTS.md (AI development guide)
# - docs/*.md (Architecture documentation)
# - README.md
# - Cargo.toml / Cargo.lock
# - All source code in src/

# =============================================================================

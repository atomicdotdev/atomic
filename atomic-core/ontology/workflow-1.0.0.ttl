@prefix atomic: <https://atomic.dev/ns/workflow#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://atomic.dev/ns/workflow> a owl:Ontology ;
    owl:versionIRI <https://atomic.dev/ns/workflow/1.0.0> ;
    rdfs:label "Atomic workflow ontology" ;
    rdfs:comment "Workflow facts over Atomic's common causal graph and view membership filters. Version 1.0.0." .

atomic:WorkIntent a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:FeatureIntent a owl:Class ; rdfs:subClassOf atomic:WorkIntent .
atomic:BugIntent a owl:Class ; rdfs:subClassOf atomic:WorkIntent .
atomic:ReviewIntent a owl:Class ; rdfs:subClassOf atomic:WorkIntent .
atomic:ManagedIntent a owl:Class ; rdfs:subClassOf atomic:WorkIntent .
atomic:Goal a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:Memory a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:Skill a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:ToolResult a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:Task a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:AcceptanceCriterion a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:ScopeItem a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:Constraint a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:Todo a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:Session a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:SessionTurn a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:ManagedTurn a owl:Class ; rdfs:subClassOf atomic:SessionTurn .
atomic:ProvenanceGraph a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:Attestation a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:Finding a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:Change a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:View a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:File a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:Identity a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:Concept a owl:Class ; rdfs:subClassOf skos:Concept .
atomic:Project a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:ProjectIdentity a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:VerificationStatus a owl:Class ; rdfs:subClassOf owl:Thing .
atomic:Verified a owl:NamedIndividual, atomic:VerificationStatus .
atomic:Unverifiable a owl:NamedIndividual, atomic:VerificationStatus .
atomic:Failed a owl:NamedIndividual, atomic:VerificationStatus .

atomic:hasTurn a owl:ObjectProperty ; rdfs:domain atomic:Session ; rdfs:range atomic:SessionTurn ; owl:inverseOf atomic:turnOfSession .
atomic:hasPlan a owl:ObjectProperty ; rdfs:domain atomic:SessionTurn ; rdfs:range atomic:WorkIntent ; owl:inverseOf atomic:governsTurn .
atomic:generatedChange a owl:ObjectProperty ; rdfs:domain atomic:SessionTurn ; rdfs:range atomic:Change ; owl:inverseOf atomic:generatedBy ; rdfs:subPropertyOf prov:generated .
atomic:informedBy a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:subPropertyOf prov:wasDerivedFrom .
atomic:explainedBy a owl:ObjectProperty ; rdfs:range atomic:ProvenanceGraph .
atomic:turnExplainedBy a owl:ObjectProperty ; rdfs:domain atomic:SessionTurn ; rdfs:range atomic:ProvenanceGraph ; rdfs:subPropertyOf atomic:explainedBy .
atomic:changeExplainedBy a owl:ObjectProperty ; rdfs:domain atomic:Change ; rdfs:range atomic:ProvenanceGraph ; rdfs:subPropertyOf atomic:explainedBy ; owl:propertyChainAxiom (atomic:generatedBy atomic:turnExplainedBy) .
atomic:hasTodo a owl:ObjectProperty ; rdfs:domain atomic:SessionTurn ; rdfs:range atomic:Todo .
atomic:blocks a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:WorkIntent ; owl:inverseOf atomic:blockedBy .
atomic:assignedTo a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:Identity .
atomic:linkedIntent a owl:ObjectProperty ; rdfs:domain atomic:Goal ; rdfs:range atomic:WorkIntent .
atomic:linkedGoal a owl:ObjectProperty ; rdfs:range atomic:Goal .
atomic:references a owl:ObjectProperty ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
atomic:hasLabel a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range skos:Concept .
atomic:hasTask a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:Task .
atomic:hasAcceptanceCriterion a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:AcceptanceCriterion .
atomic:hasScopeIn a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:ScopeItem ; rdfs:subPropertyOf atomic:hasScopeItem .
atomic:hasScopeOut a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:ScopeItem ; rdfs:subPropertyOf atomic:hasScopeItem .
atomic:hasConstraint a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:Constraint .
atomic:satisfies a owl:ObjectProperty ; rdfs:domain atomic:Task ; rdfs:range atomic:AcceptanceCriterion .
atomic:touches a owl:ObjectProperty ; rdfs:domain atomic:Task ; rdfs:range atomic:File .
atomic:scopeOutFile a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:File .
atomic:remediates a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:WorkIntent .
atomic:reviews a owl:ObjectProperty ; rdfs:domain atomic:ReviewIntent ; rdfs:range atomic:WorkIntent ; owl:inverseOf atomic:reviewedBy .
atomic:directlyDependsOnChange a owl:ObjectProperty ; rdfs:domain atomic:Change ; rdfs:range atomic:Change ; rdfs:subPropertyOf atomic:dependsOn .
atomic:dependsOnIntent a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:WorkIntent ; rdfs:subPropertyOf atomic:dependsOn .
atomic:modifiesFile a owl:ObjectProperty ; rdfs:domain atomic:Change ; rdfs:range atomic:File ; rdfs:subPropertyOf atomic:modifies .
atomic:directlyOnView a owl:ObjectProperty ; rdfs:domain atomic:Change ; rdfs:range atomic:View .
atomic:sessionViewContext a owl:ObjectProperty ; rdfs:domain atomic:Session ; rdfs:range atomic:View .
atomic:childViewOf a owl:ObjectProperty ; rdfs:domain atomic:View ; rdfs:range atomic:View .
atomic:visibleFrom a owl:ObjectProperty ; rdfs:comment "Query-time visibility operator; never stored as direct membership." .
atomic:authoredBy a owl:ObjectProperty ; rdfs:domain owl:Thing ; rdfs:range atomic:Identity ; rdfs:subPropertyOf prov:wasAttributedTo .
atomic:coversChange a owl:ObjectProperty ; rdfs:domain atomic:Attestation ; rdfs:range atomic:Change ; owl:inverseOf atomic:attestedBy .
atomic:attests a owl:ObjectProperty ; rdfs:domain atomic:Attestation ; rdfs:range atomic:SessionTurn .
atomic:attestsSession a owl:ObjectProperty ; rdfs:domain atomic:Attestation ; rdfs:range atomic:Session .
atomic:signedBy a owl:ObjectProperty ; rdfs:domain atomic:Attestation ; rdfs:range atomic:Identity .
atomic:previousAttestation a owl:ObjectProperty ; rdfs:domain atomic:Attestation ; rdfs:range atomic:Attestation .
atomic:implements a owl:ObjectProperty ; rdfs:domain atomic:Change ; rdfs:range atomic:WorkIntent ; owl:propertyChainAxiom (atomic:generatedBy atomic:hasPlan) .
atomic:attestedBy a owl:ObjectProperty ; rdfs:domain atomic:Change ; rdfs:range atomic:Attestation ; owl:inverseOf atomic:coversChange .
atomic:aboutResource a owl:ObjectProperty ; rdfs:domain atomic:Finding ; rdfs:range owl:Thing .
atomic:dependsOn a owl:ObjectProperty, owl:TransitiveProperty .
atomic:modifies a owl:ObjectProperty ; rdfs:domain atomic:Change .
atomic:hasScopeItem a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:ScopeItem .
atomic:ancestorView a owl:ObjectProperty, owl:TransitiveProperty ; rdfs:domain atomic:View ; rdfs:range atomic:View .
atomic:turnOfSession a owl:ObjectProperty ; rdfs:domain atomic:SessionTurn ; rdfs:range atomic:Session ; owl:inverseOf atomic:hasTurn .
atomic:governsTurn a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:SessionTurn ; owl:inverseOf atomic:hasPlan .
atomic:generatedBy a owl:ObjectProperty ; rdfs:domain atomic:Change ; rdfs:range atomic:SessionTurn ; owl:inverseOf atomic:generatedChange .
atomic:blockedBy a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:WorkIntent ; owl:inverseOf atomic:blocks .
atomic:reviewedBy a owl:ObjectProperty ; rdfs:domain atomic:WorkIntent ; rdfs:range atomic:ReviewIntent ; owl:inverseOf atomic:reviews .
atomic:verificationResult a owl:ObjectProperty ; rdfs:domain atomic:Attestation ; rdfs:range atomic:VerificationStatus ; rdfs:comment "Asserted only by the cryptographic verifier; never inferred." .
atomic:hasIdentity a owl:ObjectProperty ; rdfs:domain atomic:Project ; rdfs:range atomic:ProjectIdentity .
atomic:issuer a owl:ObjectProperty ; rdfs:domain atomic:ProjectIdentity ; rdfs:range atomic:Identity .

atomic:status a owl:DatatypeProperty ; rdfs:range xsd:string .
atomic:priority a owl:DatatypeProperty ; rdfs:range xsd:string .
atomic:findingCode a owl:DatatypeProperty ; rdfs:domain atomic:Finding ; rdfs:range xsd:string .
atomic:projectId a owl:DatatypeProperty ; rdfs:domain atomic:ProjectIdentity ; rdfs:range xsd:string .
atomic:schemaVersion a owl:DatatypeProperty ; rdfs:domain atomic:ProjectIdentity ; rdfs:range xsd:nonNegativeInteger .
atomic:turnNumber a owl:DatatypeProperty ; rdfs:domain atomic:SessionTurn ; rdfs:range xsd:nonNegativeInteger .

prov:wasInformedBy rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .
prov:wasDerivedFrom rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .
prov:used rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .
prov:generated rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .
prov:wasAttributedTo rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .
rdfs:label rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#> .
dcterms:description rdfs:isDefinedBy <http://purl.org/dc/terms/> .
dcterms:created rdfs:isDefinedBy <http://purl.org/dc/terms/> .
dcterms:modified rdfs:isDefinedBy <http://purl.org/dc/terms/> .
